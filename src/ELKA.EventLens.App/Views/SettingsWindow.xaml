<Window x:Class="ELKA.EventLens.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="/ELKA.EventLens.App;component/Assets/EventLens-v1.ico"
        Width="560"
        Height="780"
        MinWidth="460"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Settings"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,18" />

                    <Button Content="Appearance..." Click="Appearance_Click"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,18" />

                    <TextBlock Text="Notifications"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Enable notifications"
                              IsChecked="{Binding EnableNotifications}"
                              Margin="0,0,0,10" />
                    <Button Content="Test notification"
                            Command="{Binding TestNotificationCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,18" />

                    <TextBlock Text="Startup"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Start minimized"
                              IsChecked="{Binding StartMinimized}"
                              Margin="0,0,0,18" />

                    <TextBlock Text="Monitor logs"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Application"
                              IsChecked="{Binding MonitorApplication}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="System"
                              IsChecked="{Binding MonitorSystem}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Security"
                              IsChecked="{Binding MonitorSecurity}"
                              Margin="0,0,0,18" />

                    <TextBlock Text="Severity filters"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Critical"
                              IsChecked="{Binding ShowCritical}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Errors"
                              IsChecked="{Binding ShowErrors}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Warnings"
                              IsChecked="{Binding ShowWarnings}"
                              Margin="0,0,0,18" />

                    <TextBlock Text="History"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Max stored events"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding MaxStoredEvents, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,14" />

                    <CheckBox Content="Load recent events on startup"
                              IsChecked="{Binding LoadRecentOnStartup}"
                              Margin="0,0,0,10" />

                    <TextBlock Text="Recent events to load"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding RecentEventsToLoad, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,18" />

                    <TextBlock Text="Embedded browser"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Dark web pages"
                              IsChecked="{Binding WebBrowserDarkMode}"
                              Margin="0,0,0,18" />

                    <TextBlock Text="Search engine" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding SearchEngineOptions}" SelectedItem="{Binding SearchEngine}" Margin="0,0,0,18" />

                    <TextBlock Text="AI provider"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding AiProviderOptions}"
                              SelectedItem="{Binding SelectedAiProvider}"
                              Height="32"
                              Background="{DynamicResource InputBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,10" />
                    <Button Content="Log in / check session"
                            Command="{Binding OpenAiLoginCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,18" />

                    <Expander Header="Advanced Chat Prompt" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox Content="Use custom prompt" IsChecked="{Binding UseAdvancedAiPrompt}" Margin="0,0,0,10" />
                            <TextBox x:Name="PromptEditor" Text="{Binding AdvancedAiPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="230" Padding="8" MaxLength="20000"
                                     HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                            <DockPanel Margin="0,10,0,0">
                                <Button Content="Restore default" Command="{Binding ResetAiPromptCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" />
                                <ComboBox x:Name="PromptFieldPicker" ItemsSource="{Binding PromptFields}" SelectedIndex="7" Width="125" HorizontalAlignment="Left" />
                                <Button Content="+" Width="32" MinWidth="0" ToolTip="Insert event field" Click="InsertPromptField_Click"
                                        Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Margin="6,0,0,8" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Save"
                    Click="Save_Click"
                    Style="{StaticResource ToolbarButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>


