<Window x:Class="ELKA.EventLens.App.Views.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ELKA.EventLens.App.Controls"
        Title="Appearance" Width="770" Height="600" MinWidth="540" MinHeight="420"
        Icon="/ELKA.EventLens.App;component/Assets/EventLens-v1.ico"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Colors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="165" Margin="0,0,12,20">
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <controls:HueWheel Hue="{Binding Hue}" Swatch="{Binding Swatch}" Width="132" Height="132"
                                               Margin="0,8" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}" />
                            <TextBlock Text="{Binding Hex}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Reset ELKA colors" Command="{Binding ResetCommand}" DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Apply" IsDefault="True" Click="Apply_Click" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
