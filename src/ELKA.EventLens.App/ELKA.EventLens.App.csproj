<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ELKA.EventLens.App</AssemblyName>
    <RootNamespace>ELKA.EventLens.App</RootNamespace>
    <ApplicationIcon>Assets\EventLens-v1.ico</ApplicationIcon>
    <Version>0.1.0-dev.3</Version>
    <Company>ElkaSoft</Company>
    <Product>ELKA EventLens</Product>
    <Description>Development preview of the ELKA EventLens Windows Event Log helper.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <Resource Include="Assets\EventLens-v1.ico" />
  </ItemGroup>

</Project>
