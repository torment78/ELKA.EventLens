<Window x:Class="ELKA.EventLens.App.Views.AiLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="980"
        Icon="/ELKA.EventLens.App;component/Assets/EventLens-v1.ico"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Close"
                        Click="Close_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" />
                <TextBlock x:Name="ProviderTitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="LoginWebView"
                      Grid.Row="1" />
    </Grid>
</Window>
