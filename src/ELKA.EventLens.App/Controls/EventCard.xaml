<UserControl x:Class="ELKA.EventLens.App.Controls.EventCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,0,0,12"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{Binding AccentBrush}"
                    CornerRadius="8,0,0,8" />

            <Expander Grid.Column="1"
                      IsExpanded="{Binding IsExpanded}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextBrush}">
                <Expander.Header>
                    <Grid Margin="12,10,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Background="{Binding SeverityBackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SeverityLabel}"
                                               Foreground="{Binding AccentBrush}"
                                               FontWeight="Bold"
                                               FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           Grid.Column="1"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding Explanation.ShortSummary}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="18,0,0,0"
                                    Width="190"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TimeText}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding SourceText}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding EventIdText}"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <Grid x:Name="EventDetails" Margin="14,0,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Message"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Entry.Message}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1"
                          Margin="0,0,0,14"
                          HorizontalAlignment="Left"
                          MaxWidth="760">
                        <StackPanel Width="300" MaxWidth="{Binding ActualWidth, ElementName=EventDetails}" Margin="0,0,18,8">
                            <TextBlock Text="Suggested meaning"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Explanation.SeverityAdvice}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Width="300" MaxWidth="{Binding ActualWidth, ElementName=EventDetails}">
                            <TextBlock Text="Possible causes"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Explanation.PossibleCauses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=- {0}}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="Recommended next steps"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Explanation.RecommendedNextSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=- {0}}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <WrapPanel x:Name="TechnicalPanels" Grid.Row="3"
                          Margin="0,0,0,14"
                          HorizontalAlignment="Left"
                          MaxWidth="1280">
                        <Grid Margin="0,0,18,8"
                              Width="200">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="Technical details"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBox Grid.Row="1"
                                     Width="200"
                                     Height="165"
                                     Text="{Binding TechnicalDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Background="{DynamicResource InputBrush}"
                                     Padding="8" />
                        </Grid>

                        <Grid x:Name="RawXmlPanel"
                              MaxWidth="{Binding ActualWidth, ElementName=EventDetails}"
                              Width="500">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="Raw XML"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBox Grid.Row="1"
                                     Height="165"
                                     Text="{Binding Entry.RawXml, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Background="{DynamicResource InputBrush}"
                                     Padding="8" />
                        </Grid>
                    </WrapPanel>

                    <WrapPanel Grid.Row="4">
                        <Button Content="Open Microsoft Help"
                                Command="{Binding OpenMicrosoftHelpCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Use AI"
                                Command="{Binding UseAiCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Content="Search Web"
                                Command="{Binding SearchWebCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Search Reddit"
                                Command="{Binding SearchRedditCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Search Stack Overflow"
                                Command="{Binding SearchStackOverflowCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Search Microsoft"
                                Command="{Binding SearchMicrosoftCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </Grid>
            </Expander>
        </Grid>
    </Border>
</UserControl>















