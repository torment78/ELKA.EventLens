<Window x:Class="ELKA.EventLens.App.Views.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430"
        SizeToContent="Height"
        MaxHeight="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Padding="12,10"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button Content="Open main"
                                Command="{Binding OpenMainCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="x"
                                Command="{Binding HideCommand}"
                                Width="28"
                                Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ELKA EventLens"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding CountText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="430">
                    <StackPanel>
                        <TextBlock Text="No notifications yet. New Error and Critical events will appear here."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="4,2,4,4"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ItemsControl ItemsSource="{Binding Items}"
                                      Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,0,0,9"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="NotificationCard_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{Binding AccentBrush}"
                                                    CornerRadius="8,0,0,8" />

                                            <StackPanel Grid.Column="1"
                                                        Margin="10,9,10,10">
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1"
                                                            Background="{Binding SeverityBackgroundBrush}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="7,2"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding HasRepeats, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding CountText}"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding SourceText}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,5" />
                                                <TextBlock Text="{Binding SummaryText}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="48" />
                                                <TextBlock Text="{Binding TimeText}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,5,0,0" />

                                                <Border Background="{DynamicResource PanelAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8"
                                                        Margin="0,8,0,0"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding DetailText}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
